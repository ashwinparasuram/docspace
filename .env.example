# ---------------------------------------------------------------------------
# DocSpace configuration. Copy to .env (or run `npm run setup`).
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=
# Public URL of the app (used for links, cookies and the default site URLs)
APP_URL=http://localhost:4000
# Long random string used to sign cookies/tokens. `npm run setup` generates one.
APP_SECRET=change-me-to-a-long-random-string
# Set to true when running behind a reverse proxy (Caddy/Nginx) so client IPs are correct
TRUST_PROXY=false
# Allow anyone to sign up (the first user always can and becomes the instance admin)
ALLOW_REGISTRATION=true

# MySQL 8+ or MariaDB 10.6+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=docspace
DB_PASSWORD=docspace
DB_NAME=docspace
DB_POOL=15

# Redis (optional). Leave empty for single-node mode with an in-memory cache.
# Required when running several app instances behind a load balancer.
REDIS_URL=

# Object storage: local (default) or s3 (any self-hosted S3-compatible server, e.g. MinIO)
STORAGE_DRIVER=local
STORAGE_DIR=data/uploads
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=docspace
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=50

# AI (optional, self-hosted). none | ollama | openai (any OpenAI-compatible server)
#   ollama:  AI_BASE_URL=http://127.0.0.1:11434  AI_CHAT_MODEL=llama3.2  AI_EMBED_MODEL=nomic-embed-text
#   LM Studio / llama.cpp / vLLM: AI_PROVIDER=openai  AI_BASE_URL=http://127.0.0.1:1234
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_CHAT_MODEL=llama3.2
AI_EMBED_MODEL=

# Allow the API playground relay to call private-network hosts (e.g. an API on localhost)
PLAYGROUND_PROXY_ALLOW_PRIVATE=false

LOG_LEVEL=info
